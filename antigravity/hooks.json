{
  "pstack-checkpoint": {
    "SessionStart": [
      { "type": "command", "command": "node ./hooks/checkpoint_context.mjs", "timeout": 10 }
    ],
    "PreInvocation": [
      { "type": "command", "command": "node ./hooks/checkpoint_context.mjs", "timeout": 10 }
    ]
  },
  "pstack-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          { "type": "command", "command": "node ./hooks/git_gate.mjs", "timeout": 10 }
        ]
      }
    ]
  }
}
